# Carbon Intelligence Operating System — environment configuration
#
# Copy to `.env` and fill in the values you have — `.env` rather than
# `.env.local` because Next.js loads both but the Prisma CLI loads only `.env`,
# so DATABASE_URL and DIRECT_URL placed in `.env.local` are invisible to
# `prisma migrate deploy`. Both files are gitignored.
#
# Copying this file is optional: it ships with empty values, and empty is
# treated as unconfigured, so `npm ci` and `npm run dev` work on a fresh clone
# with no env file at all (demo mode).
#
# Nothing here is optional-by-accident: every variable below is read by the
# code, and the comment states exactly what degrades when it is absent. The same
# predicates power the Settings → "Environment configuration" panel, so that page
# and this file cannot disagree.
#
# Step-by-step instructions for obtaining each value (accounts, consoles, costs)
# are in docs/CIOS-직접-설정-가이드.docx.

# --- Required -----------------------------------------------------------------

# PostgreSQL connection string used by Prisma at runtime (pooled connection when
# your provider offers one). Without it the application runs in demo mode: reads
# fall back to the bundled fixture dataset — still computed by the real engines —
# and every mutation returns DEMO_MODE instead of persisting. Values containing
# "placeholder" are deliberately treated as unset.
DATABASE_URL=

# Direct (non-pooled) PostgreSQL connection string. Read by prisma/schema.prisma
# for `prisma migrate deploy` / `prisma db push`. Without it migrations must be
# run against DATABASE_URL, which fails on providers that only allow DDL over
# the direct connection.
DIRECT_URL=

# Supabase project URL, used for authentication. Without it (and the anon key
# below) there is no identity provider: a demo administrator session is used,
# the sign-in and registration pages report the misconfiguration, and OAuth is
# unavailable.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (publishable) key that pairs with the URL above. Safe to
# expose to the browser; the service-role key is never read by this codebase.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional -----------------------------------------------------------------

# OpenAI API key for generative narrative. Without it narrative text is
# generated deterministically from the calculation traces; every numeric result
# — anomalies, forecasts, confidence — is unaffected.
OPENAI_API_KEY=

# Chat-completions model to use. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Override the OpenAI-compatible endpoint (Azure OpenAI, a gateway, a proxy).
# Defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=

# OpenAI organization id, sent as the OpenAI-Organization header when set.
OPENAI_ORGANIZATION=

# Per-request timeout in milliseconds for LLM calls. Defaults to 60000.
OPENAI_TIMEOUT_MS=

# 32-byte key (64 hex characters, or base64) for AES-256-GCM encryption of
# DataSource.credentials, User.mfaSecret and MCP server configuration.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, registering a data source with credentials fails: field
# encryption refuses to run without a key rather than storing plaintext.
FIELD_ENCRYPTION_KEY=

# Mapbox access token. Without it the organisation page shows a facility
# coordinate list instead of an interactive map.
MAPBOX_ACCESS_TOKEN=

# Redis connection string for shared API rate limiting. Without it rate
# limiting stays in-process, so each server instance keeps its own token
# buckets.
REDIS_URL=

# Password for the local administrator user created by `npm run db:seed`.
# Without it the seed falls back to a documented default and prints a warning —
# set it before seeding, or change the password immediately afterwards.
SEED_ADMIN_PASSWORD=

# Default API-gateway rate limit in requests per minute per API key.
# Defaults to 60. Keys carrying the `rate:unlimited` scope bypass the limit.
API_RATE_LIMIT_PER_MINUTE=
