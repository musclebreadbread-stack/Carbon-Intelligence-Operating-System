  version     String
  framework   String
  description String?
  formula     String?
  parameters  Json?
  sourceUrl   String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calculations EmissionCalculation[]
  formulas     CalculationFormula[]

  @@unique([name, version])
}

model CalculationFormula {
  id              String    @id @default(cuid())
  name            String
  expression      String
  variables       Json
  description     String?
  applicableScope GHGScope?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  methodologyId String
  methodology   CalculationMethodology @relation(fields: [methodologyId], references: [id])

  @@index([methodologyId])
}

model UncertaintyAnalysis {
