  explanation   AIExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  @@index([explanationId])
  @@index([stepNumber])
}

model AssumptionLog {
  id            String   @id @default(cuid())
  assumption    String
  category      String?
  justification String?
  source        String?
  impact        String?
  sensitivity   Float?
  isValidated   Boolean  @default(false)
  validatedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  explanationId String
  explanation   AIExplanation @relation(fields: [explanationId], references: [id])

  @@index([explanationId])
  @@index([category])
}

model CalculationTrace {
  id         String   @id @default(cuid())
  stepName   String
  formula    String?
  inputs     Json?
  output     Float?
  unit       String?
  notes      String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  explanationId String
  explanation   AIExplanation @relation(fields: [explanationId], references: [id])

  @@index([explanationId])
}

model ConfidenceBreakdown {
  id          String   @id @default(cuid())
  factor      String
  score       Float
  weight      Float?
  description String?
  methodology String?
  createdAt   DateTime @default(now())

  explanationId String
  explanation   AIExplanation @relation(fields: [explanationId], references: [id])

  @@index([explanationId])
}

model EvidenceLink {
  id          String   @id @default(cuid())
  title       String
  type        String
  url         String?
  description String?
  relevance   Float?
  createdAt   DateTime @default(now())

  explanationId String
  explanation   AIExplanation @relation(fields: [explanationId], references: [id])

  @@index([explanationId])
  @@index([type])
}

// ============================================================================
// AI AGENT & MCP PLATFORM
// ============================================================================

model Agent {
  id           String      @id @default(cuid())
  name         String
  type         String
  description  String?
  version      String?
  capabilities String[]
  config       Json?
  status       AgentStatus @default(IDLE)
  isActive     Boolean     @default(true)
  lastActiveAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  tasks          AgentTask[]
  executions     AgentExecution[]
  tools          AgentTool[]
  conversations  AgentConversation[]
  mcpConnections MCPConnection[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

model AgentTask {
  id           String      @id @default(cuid())
  name         String
  description  String?
  type         String?
  priority     Int         @default(0)
  status       AgentStatus @default(IDLE)
  input        Json?
  output       Json?
  errorMessage String?
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  timeout      Int?
  retryCount   Int         @default(0)
  maxRetries   Int         @default(3)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  executions AgentExecution[]

  @@index([agentId])
  @@index([status])
  @@index([scheduledAt])
}

model AgentExecution {
  id           String      @id @default(cuid())
  status       AgentStatus @default(RUNNING)
  input        Json?
  output       Json?
  logs         Json?
  tokensUsed   Int?
  costUsd      Float?
  duration     Int?
  errorMessage String?
  startedAt    DateTime    @default(now())
  completedAt  DateTime?
  createdAt    DateTime    @default(now())

  agentId String
  agent   Agent      @relation(fields: [agentId], references: [id])
  taskId  String?
  task    AgentTask? @relation(fields: [taskId], references: [id])

  @@index([agentId])
  @@index([taskId])
  @@index([status])
  @@index([startedAt])
}

model AgentTool {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String
  schema      Json?
  config      Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([type])
}

model MCPServer {
  id              String    @id @default(cuid())
  name            String
  url             String
  description     String?
  version         String?
  protocol        String    @default("stdio")
  capabilities    Json?
  status          String    @default("active")
  healthCheckUrl  String?
  lastHealthCheck DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  connections MCPConnection[]

  @@index([status])
}

model MCPConnection {
  id         String    @id @default(cuid())
  status     String    @default("connected")
  config     Json?
  lastPingAt DateTime?
  errorCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agentId  String
  agent    Agent     @relation(fields: [agentId], references: [id])
  serverId String
  server   MCPServer @relation(fields: [serverId], references: [id])

  @@unique([agentId, serverId])
  @@index([agentId])
  @@index([serverId])
}

model AgentConversation {
  id        String   @id @default(cuid())
  title     String?
  context   Json?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  messages AgentMessage[]

  @@index([agentId])
  @@index([userId])
}

model AgentMessage {
  id         String   @id @default(cuid())
  role       String
  content    String
  metadata   Json?
  tokensUsed Int?
  createdAt  DateTime @default(now())

  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// ============================================================================
// SBTi & TARGETS
// ============================================================================

model ScienceBasedTarget {
  id                String         @id @default(cuid())
  name              String
  boundary          TargetBoundary
  baselineYear      Int
  baselineEmissions Float?
  targetYear        Int
  targetReduction   Float
  targetAbsolute    Float?
  currentEmissions  Float?
  currentProgress   Float?         @default(0)
  methodology       String?
  status            TargetStatus   @default(DRAFT)
  submittedAt       DateTime?
  approvedAt        DateTime?
  validatedBy       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  targetTypeId   String?
  targetType     TargetType?  @relation(fields: [targetTypeId], references: [id])

  progress          TargetProgress[]
  netZeroCommitment NetZeroCommitment?
  flagTarget        FLAGTarget?
  baselineYearData  BaselineYear?

  @@index([organizationId])
  @@index([status])
  @@index([boundary])
}

model TargetType {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  methodology String?
  pathway     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  targets ScienceBasedTarget[]
}

model TargetProgress {
  id                    String    @id @default(cuid())
  year                  Int
  emissions             Float
  reductionFromBaseline Float?
  reductionPercent      Float?
  isOnTrack             Boolean?
  notes                 String?
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  targetId String
  target   ScienceBasedTarget @relation(fields: [targetId], references: [id])

  @@unique([targetId, year])
  @@index([targetId])
  @@index([year])
}

model NetZeroCommitment {
  id                     String       @id @default(cuid())
  pledgeYear             Int
  netZeroYear            Int
  interimTarget          Float?
  interimYear            Int?
  residualEmissions      Float?
  neutralizationStrategy String?
  status                 TargetStatus @default(DRAFT)
  declaredAt             DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  targetId String             @unique
  target   ScienceBasedTarget @relation(fields: [targetId], references: [id])
}

model FLAGTarget {
  id                String       @id @default(cuid())
  sector            String
  commodity         String?
  baselineEmissions Float?
  targetReduction   Float?
  landUseChange     Float?
  methodology       String?
  status            TargetStatus @default(DRAFT)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  targetId String             @unique
  target   ScienceBasedTarget @relation(fields: [targetId], references: [id])
}

model BaselineYear {
  id                  String    @id @default(cuid())
  year                Int
  scope1Emissions     Float?
  scope2Emissions     Float?
  scope3Emissions     Float?
  totalEmissions      Float?
  methodology         String?
  isRecalculated      Boolean   @default(false)
  recalculationReason String?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  targetId String             @unique
  target   ScienceBasedTarget @relation(fields: [targetId], references: [id])
}

// ============================================================================
// NOTIFICATIONS & WORKFLOW
// ============================================================================

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(INFO)
  title     String
  message   String
  channel   String           @default("in_app")
  isRead    Boolean          @default(false)
  readAt    DateTime?
  actionUrl String?
  metadata  Json?
  expiresAt DateTime?
  createdAt DateTime         @default(now())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  channel   String
  eventType String
  isEnabled Boolean  @default(true)
  frequency String?  @default("immediate")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, eventType])
  @@index([userId])
}

model Workflow {
  id            String         @id @default(cuid())
  name          String
  description   String?
  type          String?
  status        WorkflowStatus @default(DRAFT)
  triggerType   String?
  triggerConfig Json?
  isActive      Boolean        @default(true)
  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  steps      WorkflowStep[]
  executions WorkflowExecution[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

model WorkflowStep {
  id          String   @id @default(cuid())
  name        String
  type        String
  config      Json?
  orderIndex  Int      @default(0)
  isRequired  Boolean  @default(true)
  timeout     Int?
  retryConfig Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  approvals Approval[]

  @@index([workflowId])
}

model WorkflowExecution {
  id           String         @id @default(cuid())
  status       WorkflowStatus @default(ACTIVE)
  currentStep  Int            @default(0)
  input        Json?
  output       Json?
  errorMessage String?
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id])

  approvals Approval[]

  @@index([workflowId])
  @@index([status])
}

model Approval {
  id           String         @id @default(cuid())
  status       ApprovalStatus @default(PENDING)
  comments     String?
  decidedAt    DateTime?
  dueDate      DateTime?
  reminderSent Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  approverId  String
  approver    User               @relation(fields: [approverId], references: [id])
  stepId      String?
  step        WorkflowStep?      @relation(fields: [stepId], references: [id])
  executionId String?
  execution   WorkflowExecution? @relation(fields: [executionId], references: [id])

  @@index([approverId])
  @@index([stepId])
  @@index([executionId])
  @@index([status])
}
