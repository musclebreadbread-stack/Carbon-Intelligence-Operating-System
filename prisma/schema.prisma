  calculation   EmissionCalculation @relation(fields: [calculationId], references: [id])
  resultId      String?
  result        EmissionResult?     @relation(fields: [resultId], references: [id])

  @@index([calculationId])
  @@index([targetEntity, targetEntityId])
}

model CalculationMethodology {
  id          String   @id @default(cuid())
