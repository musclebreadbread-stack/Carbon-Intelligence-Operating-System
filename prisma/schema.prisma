  issuedAt    DateTime?
  expiresAt   DateTime?
  signedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  engagementId String
  engagement   VerificationEngagement @relation(fields: [engagementId], references: [id])

  signatures DigitalSignature[]

  @@index([engagementId])
}

model DigitalSignature {
  id            String   @id @default(cuid())
  signerName    String
  signerEmail   String?
  signerOrg     String?
  signatureHash String
  algorithm     String?
  certificate   String?
  signedAt      DateTime @default(now())
  isValid       Boolean  @default(true)
  createdAt     DateTime @default(now())

  statementId String
  statement   VerificationStatement @relation(fields: [statementId], references: [id])

  @@index([statementId])
}

model EvidencePackage {
  id          String    @id @default(cuid())
