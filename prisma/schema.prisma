  unit           String            @default("tCO2e")
  biogenicCO2    Float?            @default(0)
  scope          GHGScope
  scope3Category Scope3Category?
  dataQuality    DataQualityLevel?
  calculatedAt   DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  calculationId       String
  calculation         EmissionCalculation @relation(fields: [calculationId], references: [id])
  emissionSourceId    String?
  emissionSource      EmissionSource?     @relation(fields: [emissionSourceId], references: [id])
