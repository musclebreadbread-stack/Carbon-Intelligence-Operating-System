model MonitoringPlan {
  id            String               @id @default(cuid())
  name          String
  description   String?
  frequency     MeasurementFrequency
  startDate     DateTime
  endDate       DateTime?
  status        String               @default("active")
  lastExecuted  DateTime?
  nextExecution DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  mrvPlanId String
  mrvPlan   MRVPlan @relation(fields: [mrvPlanId], references: [id])

  parameters MonitoringParameter[]

  @@index([mrvPlanId])
  @@index([status])
}

model MonitoringParameter {
  id            String                @id @default(cuid())
  name          String
  description   String?
  unit          String
  frequency     MeasurementFrequency?
  methodology   String?
  threshold     Float?
  alertOnBreach Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  monitoringPlanId String
  monitoringPlan   MonitoringPlan  @relation(fields: [monitoringPlanId], references: [id])
  /// The source this parameter monitors. `null` means "not yet assigned", which
  /// `monitoringPlanCoverage()` correctly reports as a coverage gap. Before this
  /// column existed the data layer *guessed* the association from a substring match
  /// between the parameter name and the source name, so a plan could be reported as
  /// covering a source it did not monitor — a false assurance statement.
  emissionSourceId String?
  emissionSource   EmissionSource? @relation(fields: [emissionSourceId], references: [id])

  @@index([monitoringPlanId])
  @@index([emissionSourceId])
}

