// ============================================================================
// SECURITY & AUTH
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  passwordHash  String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userRoles            UserRole[]
  teams                TeamMember[]
  sessions             Session[]
  apiKeys              APIKey[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  approvals            Approval[]
  agentConversations   AgentConversation[]
  createdReports       DisclosureReport[]
  verificationFindings VerificationFinding[]

  @@index([organizationId])
  @@index([email])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  members TeamMember[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model Session {
  id           String   @id @default(cuid())
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model APIKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]
  /// Requests per minute allowed for this key. `null` falls back to
  /// `API_RATE_LIMIT_PER_MINUTE` (default 60). Without this column a per-key
  /// quota was impossible: every key shared one process-wide ceiling, so a batch
  /// integration could not be given more headroom than a dashboard widget and a
  /// misbehaving key could not be throttled without throttling everyone.
  rateLimit  Int?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
}

model AccessPolicy {
  id          String   @id @default(cuid())
  name        String
  description String?
  resource    String
  conditions  Json
  effect      String   @default("allow")
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([resource])
}

model EncryptionKey {
  id          String    @id @default(cuid())
  alias       String
  algorithm   String
  keyMaterial String
  purpose     String
  isActive    Boolean   @default(true)
  rotatedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, alias])
}

// ============================================================================
// ORGANIZATION HIERARCHY (7 Levels)
// ============================================================================

model Organization {
  id              String   @id @default(cuid())
  name            String
  legalName       String?
  industry        String?
  sector          String?
  country         String?
  region          String?
  address         String?
  website         String?
  logoUrl         String?
  registrationNum String?
  fiscalYearStart Int      @default(1)
  baseCurrency    String   @default("USD")
  reportingYear   Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Hierarchy children
  businessUnits BusinessUnit[]
  facilities    Facility[]

  // Related entities
  users                User[]
  roles                Role[]
  teams                Team[]
  auditLogs            AuditLog[]
  apiKeys              APIKey[]
  accessPolicies       AccessPolicy[]
  encryptionKeys       EncryptionKey[]
  emissionFactors      EmissionFactor[]
  emissionInventories  EmissionInventory[]
  products             Product[]
  suppliers            Supplier[]
  activityData         ActivityData[]
  calculations         EmissionCalculation[]
  roadmaps             DecarbonizationRoadmap[]
  scenarios            Scenario[]
  targets              ScienceBasedTarget[]
  disclosureReports    DisclosureReport[]
  verifications        VerificationEngagement[]
  carbonCredits        CarbonCredit[]
  rules                RuleSet[]
  agents               Agent[]
  workflows            Workflow[]
  notifications        Notification[]
  dataImportJobs       DataImportJob[]
  mrvPlans             MRVPlan[]
  reports              Report[]
  aiAnalyses           AIAnalysis[]
  aiModels             AIModel[]
  carbonBudgets        CarbonBudget[]
  internalCarbonPrices InternalCarbonPrice[]

  @@index([industry])
  @@index([country])
}

model BusinessUnit {
  id          String           @id @default(cuid())
  name        String
  code        String?
  description String?
  tier        OrganizationTier @default(BUSINESS_UNIT)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  facilities      Facility[]
  activityData    ActivityData[]
  emissionResults EmissionResult[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Facility {
  id                 String   @id @default(cuid())
  name               String
  code               String?
  type               String?
  address            String?
  city               String?
  state              String?
  country            String?
  latitude           Float?
  longitude          Float?
  area               Float?
  areaUnit           String?  @default("sqm")
  operationalControl Boolean  @default(true)
  equityShare        Float?   @default(100)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  buildings       Building[]
  emissionSources EmissionSource[]
  activityData    ActivityData[]
  iotDevices      IoTDevice[]
  meterReadings   MeterReading[]
  emissionResults EmissionResult[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([businessUnitId])
  @@index([country])
}

model Building {
  id           String   @id @default(cuid())
  name         String
  code         String?
  type         String?
  floors       Int?
  area         Float?
  areaUnit     String?  @default("sqm")
  yearBuilt    Int?
  energyRating String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])

  productionLines ProductionLine[]
  emissionSources EmissionSource[]

  @@index([facilityId])
}

model ProductionLine {
  id           String   @id @default(cuid())
  name         String
  code         String?
  type         String?
  capacity     Float?
  capacityUnit String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])

  equipment       Equipment[]
  emissionSources EmissionSource[]

  @@index([buildingId])
}

model Equipment {
  id            String    @id @default(cuid())
  name          String
  code          String?
  type          String?
  manufacturer  String?
  model         String?
  serialNumber  String?
  installDate   DateTime?
  efficiency    Float?
  fuelTypeId    String?
  refrigerantId String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  productionLineId String
  productionLine   ProductionLine @relation(fields: [productionLineId], references: [id])
  fuelType         FuelType?      @relation(fields: [fuelTypeId], references: [id])
  refrigerant      Refrigerant?   @relation(fields: [refrigerantId], references: [id])

  emissionSources EmissionSource[]

  @@index([productionLineId])
  @@index([fuelTypeId])
}

model EmissionSource {
  id                  String              @id @default(cuid())
  name                String
  code                String?
  scope               GHGScope
  scope3Category      Scope3Category?
  sourceType          String?
  description         String?
  calculationApproach CalculationApproach @default(ACTIVITY_BASED)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  facilityId       String?
  facility         Facility?       @relation(fields: [facilityId], references: [id])
  buildingId       String?
  building         Building?       @relation(fields: [buildingId], references: [id])
  productionLineId String?
  productionLine   ProductionLine? @relation(fields: [productionLineId], references: [id])
  equipmentId      String?
  equipment        Equipment?      @relation(fields: [equipmentId], references: [id])

  activityDataEntries  ActivityDataEntry[]
  emissionResults      EmissionResult[]
  monitoringParameters MonitoringParameter[]

  @@index([facilityId])
  @@index([scope])
  @@index([scope3Category])
}

// ============================================================================
// MASTER DATA
// ============================================================================

model Product {
  id             String   @id @default(cuid())
  name           String
  sku            String?
  category       String?
  description    String?
  unit           String?
  weight         Float?
  weightUnit     String?
  lifecycleStage String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  activityDataEntries ActivityDataEntry[]

  @@index([organizationId])
  @@index([category])
}

model RawMaterial {
  id                String   @id @default(cuid())
  name              String
  category          String?
  unit              String?
  emissionIntensity Float?
  sourceRegion      String?
  isRecycled        Boolean  @default(false)
  recycledContent   Float?   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activityDataEntries ActivityDataEntry[]

  @@index([category])
}

model Fuel {
  id             String   @id @default(cuid())
  name           String
  fuelTypeId     String
  fuelType       FuelType @relation(fields: [fuelTypeId], references: [id])
  unit           String
  netCalorific   Float?
  grossCalorific Float?
  density        Float?
  carbonContent  Float?
  isRenewable    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activityDataEntries ActivityDataEntry[]

  @@index([fuelTypeId])
}

model FuelType {
  id          String       @id @default(cuid())
  name        String       @unique
  category    FuelCategory
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  fuels     Fuel[]
  equipment Equipment[]
}

model Vehicle {
  id             String      @id @default(cuid())
  name           String
  type           VehicleType
  fuelType       String?
  make           String?
  model          String?
  year           Int?
  efficiency     Float?
  efficiencyUnit String?
  isOwned        Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  activityDataEntries ActivityDataEntry[]

  @@index([type])
}

model Refrigerant {
  id                      String   @id @default(cuid())
  name                    String   @unique
  chemicalFormula         String?
  gwp100                  Float
  gwp20                   Float?
  ozoneDepletionPotential Float?
  category                String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  equipment           Equipment[]
  activityDataEntries ActivityDataEntry[]
}

model Supplier {
  id                   String   @id @default(cuid())
  name                 String
  code                 String?
  category             String?
  country              String?
  contactEmail         String?
  tier                 Int      @default(1)
  sustainabilityRating String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  activityDataEntries ActivityDataEntry[]

  @@index([organizationId])
  @@index([category])
}

model LogisticsRoute {
  id            String   @id @default(cuid())
  name          String
  origin        String
  destination   String
  distance      Float
  distanceUnit  String   @default("km")
  transportMode String
  isReturn      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activityDataEntries ActivityDataEntry[]

  @@index([transportMode])
}

model EnergySource {
  id               String     @id @default(cuid())
  name             String
  type             EnergyType
  provider         String?
  gridRegion       String?
  renewablePercent Float?     @default(0)
  contractType     String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  activityDataEntries ActivityDataEntry[]

  @@index([type])
}

model WasteType {
  id             String   @id @default(cuid())
  name           String
  category       String?
  disposalMethod String?
  isHazardous    Boolean  @default(false)
  recyclingRate  Float?   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activityDataEntries ActivityDataEntry[]
}

model WaterSource {
  id         String   @id @default(cuid())
  name       String
  type       String?
  source     String?
  treatment  String?
  isRecycled Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activityDataEntries ActivityDataEntry[]
}

// ============================================================================
// ACTIVITY DATA
// ============================================================================

model ActivityData {
  id             String           @id @default(cuid())
  name           String
  description    String?
  scope          GHGScope
  scope3Category Scope3Category?
  reportingYear  Int
  reportingMonth Int?
  dataSource     DataSourceType   @default(MANUAL_ENTRY)
  dataQuality    DataQualityLevel @default(MEDIUM)
  isVerified     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  facilityId     String?
  facility       Facility?     @relation(fields: [facilityId], references: [id])
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  entries ActivityDataEntry[]

  @@index([organizationId])
  @@index([scope])
  @@index([reportingYear])
  @@index([facilityId])
}

model ActivityDataEntry {
  id          String   @id @default(cuid())
  quantity    Float
  unit        String
  startDate   DateTime
  endDate     DateTime
  notes       String?
  evidenceUrl String?
  isEstimated Boolean  @default(false)
  uncertainty Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activityDataId   String
  activityData     ActivityData    @relation(fields: [activityDataId], references: [id])
  emissionSourceId String?
  emissionSource   EmissionSource? @relation(fields: [emissionSourceId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  supplierId       String?
  supplier         Supplier?       @relation(fields: [supplierId], references: [id])
  vehicleId        String?
  vehicle          Vehicle?        @relation(fields: [vehicleId], references: [id])
  fuelId           String?
  fuel             Fuel?           @relation(fields: [fuelId], references: [id])
  refrigerantId    String?
  refrigerant      Refrigerant?    @relation(fields: [refrigerantId], references: [id])
  rawMaterialId    String?
  rawMaterial      RawMaterial?    @relation(fields: [rawMaterialId], references: [id])
  logisticsRouteId String?
  logisticsRoute   LogisticsRoute? @relation(fields: [logisticsRouteId], references: [id])
  energySourceId   String?
  energySource     EnergySource?   @relation(fields: [energySourceId], references: [id])
  wasteTypeId      String?
  wasteType        WasteType?      @relation(fields: [wasteTypeId], references: [id])
  waterSourceId    String?
  waterSource      WaterSource?    @relation(fields: [waterSourceId], references: [id])

  emissionResults  EmissionResult[]
  dataQualityScore DataQualityScore?

  @@index([activityDataId])
  @@index([emissionSourceId])
  @@index([startDate, endDate])
}

model DataImportJob {
  id            String       @id @default(cuid())
  name          String
  fileName      String?
  fileUrl       String?
  fileType      String?
  status        ImportStatus @default(PENDING)
  totalRows     Int?
  processedRows Int?         @default(0)
  errorRows     Int?         @default(0)
  errorLog      Json?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  organizationId String
