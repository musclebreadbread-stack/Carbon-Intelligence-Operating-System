// ============================================================================
// EMISSION ENGINE
// ============================================================================

model EmissionCalculation {
  id                   String              @id @default(cuid())
  name                 String
  reportingYear        Int
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
