// Carbon Intelligence Operating System (CIOS) - Comprehensive Prisma Schema
// Covers: Carbon Accounting, Decarbonization, Digital MRV, ESG Disclosure,
// Climate Decision Intelligence, AI Agents, and MCP Platform

generator client {
  provider = "prisma-client-js"
}

// `extensions = [vector]` was declared here for a semantic-search feature that was
// never built. With `postgresqlExtensions` enabled, Prisma emitted
// `CREATE EXTENSION IF NOT EXISTS "vector"` as the *first* statement of the
// baseline migration, which made pgvector a hard prerequisite of
// `prisma migrate deploy`: on any PostgreSQL where the extension is not installed
// or the migration role is not a superuser, the very first deploy fails before a
// single table is created — for a capability nothing in the codebase uses. No model
// has a vector column, so declaring the extension bought nothing and cost the
// ability to deploy. It is removed until semantic search is actually implemented,
// at which point re-adding it is a one-line schema change plus its own migration.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

