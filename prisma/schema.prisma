  updatedAt   DateTime  @updatedAt

  auditTrailId String?
  auditTrail   AuditTrail? @relation(fields: [auditTrailId], references: [id])

  @@index([auditTrailId])
  @@index([type])
}

model VerificationFinding {
  id                 String    @id @default(cuid())
  type               String
  severity           String
  title              String
  description        String?
  recommendation     String?
  response           String?
  status             String    @default("open")
  /// Quantified misstatement in tCO2e, signed: positive overstates the inventory,
  /// negative understates it. `null` means the verifier could not size the finding.
  /// This drives `aggregateMisstatements()` and therefore the assurance
  /// `opinionType`, so it is a first-class column: it was previously smuggled
  /// inside `description` behind a `[misstatement:N]` marker, which let a verifier
  /// silently change an audit opinion by editing prose, and which the read path
  /// never decoded at all.
  misstatementAmount Float?
  dueDate            DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  engagementId String
  engagement   VerificationEngagement @relation(fields: [engagementId], references: [id])
  assignedToId String?
  assignedTo   User?                  @relation(fields: [assignedToId], references: [id])

  @@index([engagementId])
  @@index([severity])
  @@index([status])
}

model VerificationStatement {
  id          String    @id @default(cuid())
